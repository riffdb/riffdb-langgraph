query ListThreadWriteKeys(
    $scope: CheckpointWrite.scope,
    $thread_id: CheckpointWrite.thread_id,
    $limit: Limit<256> = 256,
    $after: Cursor?,
) {
    many writes from CheckpointWrite
        where scope == $scope
          && thread_id == $thread_id
        order by checkpoint_ns asc, checkpoint_id asc, task_id asc, write_idx asc
        take $limit after $after

    return Found {
        writes: writes {
            thread_id
            checkpoint_ns
            checkpoint_id
            task_id
            write_idx
        }
    }
    outcomes Found
}
